{
  "name": "unified-creator-metrics",
  "version": "0.1.0",
  "description": "Unified TypeScript client for normalized public-facing platform metrics.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:smoke": "npm run build && node tests/smoke/run-smoke-tests.js",
    "test:smoke:youtube": "npm run build && node tests/smoke/run-smoke-tests.js youtube",
    "test:smoke:kick": "npm run build && node tests/smoke/run-smoke-tests.js kick",
    "test:smoke:twitch": "npm run build && node tests/smoke/run-smoke-tests.js twitch",
    "test:smoke:multi-platform": "npm run build && node tests/smoke/run-smoke-tests.js multi-platform",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test:manual:youtube:chat-listener": "npm run build && node tests/manual/youtube/chat-listener.js",
    "test:manual:youtube:send-chat-message": "npm run build && node tests/manual/youtube/send-chat-message.js",
    "test:manual:kick:chat-listener": "npm run build && node tests/manual/kick/chat-listener.js",
    "test:manual:kick:send-chat-message": "npm run build && node tests/manual/kick/send-chat-message.js",
    "test:manual:twitch:chat-listener": "npm run build && node tests/manual/twitch/chat-listener.js",
    "test:manual:twitch:send-chat-message": "npm run build && node tests/manual/twitch/send-chat-message.js",
    "playground:twitch:viewer-count": "node playground/twitch-live-viewer-count.js",
    "test:manual:multi-platform:chat-listener": "npm run build && node tests/manual/multi-platform/chat-listener.js",
    "test:manual:multi-platform:send-chat-message": "npm run build && node tests/manual/multi-platform/send-chat-message.js"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "dependencies": {
    "googleapis": "^171.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "dotenv": "^17.4.2",
    "eslint": "^10.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.4",
    "vitest": "^4.1.7"
  }
}
