{
  "name": "@multi-platform-api/library",
  "version": "0.1.0",
  "description": "Unified TypeScript client for normalized public-facing platform metrics.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "smoke:youtube:channel": "npm run build && node examples/youtube-followers.mjs",
    "smoke:youtube:video": "npm run build && node examples/youtube-video-metrics.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "dependencies": {
    "googleapis": "^171.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "eslint": "^10.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.4"
  }
}
