# Local development schema for smoke/manual scripts.
# Secret values are resolved from KeePassXC at runtime through Varlock.
#
# @plugin(@varlock/keepass-plugin)
# @initKeePass(dbPath=$KP_DB_PATH, password=$KP_PASSWORD, useCli=forEnv(dev))
# @defaultSensitive=true @defaultRequired=false @currentEnv=$APP_ENV
# ---

# Controls which `.env.<env>` files Varlock will try to load.
# @type=enum(dev, test)
APP_ENV=dev

# KeePassXC database used by the plugin.
KP_DB_PATH=/Users/aksuharun/Secrets/dev-secrets.kdbx

# KeePassXC database password used by the plugin.
# @type=kdbxPassword @sensitive
KP_PASSWORD=

# Shared local script defaults
# @type=port
PORT=8090

# @type=enum(youtube, kick)
CHAT_PLATFORM=youtube
CHAT_SMOKE_TIMEOUT_MS=45000
CHAT_DELETE_DELAY_MS=5000

# YouTube smoke/manual script defaults
YOUTUBE_CHANNEL_HANDLE=@HARUN-AKSU
YOUTUBE_CHANNEL_ID=UCGy9vOmYGW7quWUxJMQbvUg
YOUTUBE_LIVE_VIDEO_ID=rYBcBCmV-Pw
YOUTUBE_LIVE_CHAT_ID=
YOUTUBE_VIDEO_ID=rNahMr4Eppk
YOUTUBE_CHAT_MESSAGE=
YOUTUBE_POLL_QUESTION=
YOUTUBE_POLL_CHOICES=
YOUTUBE_MODERATION_USER_ID=
YOUTUBE_TIMEOUT_SECONDS=120

# @sensitive
YOUTUBE_API_KEY=kp("YOUTUBE_API_KEY")

# @sensitive
YOUTUBE_CLIENT_ID=kp("YOUTUBE_CLIENT_ID")

# @sensitive
YOUTUBE_CLIENT_SECRET=kp("YOUTUBE_CLIENT_SECRET")

# @sensitive
YOUTUBE_REFRESH_TOKEN=kp("YOUTUBE_REFRESH_TOKEN")

# Twitch smoke/manual script defaults
TWITCH_BROADCASTER_LOGIN=aksuharun
TWITCH_BROADCASTER_ID=
TWITCH_CHAT_MESSAGE=
TWITCH_POLL_QUESTION=
TWITCH_POLL_CHOICES=
TWITCH_POLL_DURATION_SECONDS=120
TWITCH_POLL_CHANNEL_POINTS_PER_VOTE=
TWITCH_REPLY_PARENT_MESSAGE_ID=
TWITCH_MODERATION_USER_ID=
TWITCH_DELETE_MESSAGE_ID=
TWITCH_TIMEOUT_SECONDS=120

# @sensitive
TWITCH_CLIENT_ID=kp("TWITCH_CLIENT_ID")

# @sensitive
TWITCH_CLIENT_SECRET=kp("TWITCH_CLIENT_SECRET")

# @sensitive
TWITCH_APP_ACCESS_TOKEN=

# Optional manual override for scripts that still accept a user access token.
# Smoke tests mint this from `TWITCH_REFRESH_TOKEN`.
# @sensitive
TWITCH_USER_ACCESS_TOKEN=

# @sensitive
TWITCH_REFRESH_TOKEN=kp("TWITCH_REFRESH_TOKEN")

# Kick smoke/manual script defaults
KICK_BROADCASTER_USERNAME=aksuharun
KICK_BROADCASTER_USER_ID=
KICK_CHANNEL_SLUG=aksuharun
KICK_CHAT_MESSAGE=
KICK_MODERATION_USER_ID=
KICK_TIMEOUT_SECONDS=120

# `0` disables signature verification in local webhook listeners.
KICK_VERIFY_SIGNATURE=1
KICK_WEBHOOK_PATH=/kick/webhook
KICK_WEBHOOK_CALLBACK_URL=https://sterling-arc-val-engineers.trycloudflare.com

# Leave empty to let the scripts auto-pick `ensure` when a callback URL exists.
# @type=enum(create, ensure)
KICK_SUBSCRIPTION_MODE=

# @type=enum(user, bot)
KICK_CHAT_TYPE=user

# @sensitive
KICK_CLIENT_ID=kp("KICK_CLIENT_ID")

# @sensitive
KICK_CLIENT_SECRET=kp("KICK_CLIENT_SECRET")

# @sensitive
KICK_APP_ACCESS_TOKEN=kp("KICK_APP_ACCESS_TOKEN")

# @sensitive
KICK_USER_ACCESS_TOKEN=kp("KICK_USER_ACCESS_TOKEN")

# @sensitive
KICK_REFRESH_TOKEN=kp("KICK_REFRESH_TOKEN")
